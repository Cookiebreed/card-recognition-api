{
  "info": {
    "_postman_id": "6f1c2b1e-4d3a-4b8e-9a51-2c7d0e9f3a10",
    "name": "NeoSatoshi Card Recognition API",
    "description": "Send a photo of trading cards (Pokémon, One Piece, Disney Lorcana, Yu-Gi-Oh! TCG, Magic: The Gathering), get JSON with set, number, rarity, Cardmarket ID and daily prices.\n\napiKey defaults to the public demo key (10 detections per day per network). Replace it with your own key from https://neosatoshi.com/dashboard/settings/settings#api-keys .\n\nThe call is synchronous: set the Postman request timeout to at least 120 s. Docs: https://neosatoshi.com/developers/detection-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://europe-west1-neosatoshi.cloudfunctions.net",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "nsk_live_9c253fbed995042a98280ad13e5c47d3c4a59c9b4f0f7274",
      "type": "string"
    },
    {
      "key": "imageBase64",
      "value": "PASTE_BASE64_JPEG_OR_PNG_HERE",
      "type": "string"
    },
    {
      "key": "imageUrl",
      "value": "https://example.com/your-card-photo.jpg",
      "type": "string"
    }
  ],
